---
/** Scheda pratica: indirizzo, orari, telefono, email e "Come arrivare". Legge tutto da site.json. */
import Icon from './Icon.astro';
import WeekHours from './WeekHours.astro';
import { dict } from '../i18n';
import { site, telHref, directions, addressLine, isTbc, tbc } from '../lib/data';
import type { Lang } from '../lib/routes';
interface Props {
  lang: Lang;
  title: string;
  place: keyof typeof site.places;
  service?: keyof typeof site.services;
  seasonal?: boolean;
  email?: string | null;
  note?: string;
  dark?: boolean;
}
const { lang, title, place, service, seasonal = false, note, dark = false } = Astro.props;
const T = dict[lang].common;
const p: any = site.places[place];
const email = Astro.props.email !== undefined ? Astro.props.email : service ? (site.services as any)[service].email : null;
const addr = addressLine(place, lang).replace(tbc(lang), `<span class="tbc">${tbc(lang)}</span>`);
---
<article class:list={['place card', { 'on-dark': dark }]}>
  <h3>{title}</h3>
  <ul class="place-list" role="list">
    <li><Icon name="pin" />{directions(place) ? <a href={directions(place)} target="_blank" rel="noopener"><span set:html={addr} /><span class="sr-only"> {T.newTab}</span></a> : <span set:html={addr} />}</li>
    <li><Icon name="phone" />{isTbc(p.phone) ? <span class="tbc">{tbc(lang)}</span> : <a href={telHref(p.phone)}>{p.phone}</a>}</li>
    {email && <li><Icon name="mail" /><a href={`mailto:${email}`}>{email}</a></li>}
  </ul>
  {service && (
    <div class="place-hours">
      <p class="place-h"><Icon name="clock" /> {T.hours}</p>
      {seasonal ? (
        <>
          <p class="season">{T.winter} <span class="muted small">· {T.seasonDates.winter}</span></p>
          <WeekHours service={service} lang={lang} season="winter" />
          <p class="season">{T.summer} <span class="muted small">· {T.seasonDates.summer}</span></p>
          <WeekHours service={service} lang={lang} season="summer" />
        </>
      ) : <WeekHours service={service} lang={lang} />}
      {note && <p class="small muted place-note" set:html={note} />}
    </div>
  )}
  <div class="actions">
    {directions(place) && <a class="btn btn-ghost btn-sm" href={directions(place)} target="_blank" rel="noopener"><Icon name="pin" />{T.directions}<span class="sr-only"> {T.newTab}</span></a>}
    <slot />
  </div>
</article>
<style>
  .place h3 { font-size: var(--step-2); }
  .place-list { display: grid; gap: 0.7rem; margin: 1rem 0 1.4rem; }
  .place-list li { display: flex; gap: 0.75rem; align-items: flex-start; }
  .place-list :global(.icon) { width: 1.2rem; height: 1.2rem; flex: none; margin-top: 0.25rem; color: var(--ember-ink); }
  .place-list a { text-decoration: none; font-weight: 600; }
  .place-list a:hover { text-decoration: underline; }
  .place-hours { padding-top: 1rem; border-top: 1px solid var(--line); }
  .place-h { display: flex; gap: 0.5rem; align-items: center; font-weight: 700; margin-bottom: 0.4rem; }
  .place-h :global(.icon) { width: 1.15rem; height: 1.15rem; color: var(--ember-ink); }
  .season { margin: 0.8rem 0 0; font-weight: 700; font-size: 0.92rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .place-note { margin-top: 0.8rem; }
  .actions { margin-top: 1.4rem; }
</style>
