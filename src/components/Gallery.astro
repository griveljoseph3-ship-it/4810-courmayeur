---
import Pic from './Pic.astro';
import type { Lang } from '../lib/routes';
interface Props { images: string[]; lang: Lang; layout?: 'mosaic' | 'row' }
const { images, lang, layout = 'mosaic' } = Astro.props;
---
<div class:list={['gallery', layout]}>
  {images.map((n, i) => (
    <figure class="frame zoom" data-reveal style={`--d:${(i % 4) * 0.08}s`}>
      <Pic name={n} lang={lang} sizes="(min-width: 900px) 33vw, 50vw" widths={[320, 480, 640, 960, 1280]} />
    </figure>
  ))}
</div>
<style>
  .gallery { display: grid; gap: clamp(0.6rem, 0.4rem + 0.8vw, 1.2rem); grid-template-columns: repeat(2, 1fr); }
  .gallery figure { margin: 0; aspect-ratio: 4 / 3; border-radius: var(--radius); }
  @media (min-width: 900px) {
    .mosaic { grid-auto-flow: dense; grid-template-columns: repeat(6, 1fr); grid-auto-rows: clamp(11rem, 8rem + 6vw, 17rem); }
    .mosaic figure { aspect-ratio: auto; grid-column: span 2; }
    .mosaic figure:nth-child(6n + 1) { grid-column: span 4; grid-row: span 2; }
    .mosaic figure:nth-child(6n + 4) { grid-column: span 3; }
    .mosaic figure:nth-child(6n + 5) { grid-column: span 3; }
    .row { grid-template-columns: repeat(4, 1fr); }
  }
</style>
