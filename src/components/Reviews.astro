---
import Icon from './Icon.astro';
import reviews from '../data/reviews.json';
import { dict, fill } from '../i18n';
import type { Lang } from '../lib/routes';
interface Props { lang: Lang; service?: 'food' | 'rental'; limit?: number }
const { lang, service, limit = 3 } = Astro.props;
const T = dict[lang].home.reviews;
const list = reviews.reviews.filter((r) => !service || r.service === service).slice(0, limit);
const s = reviews.summary;
const fmtDate = (d: string) => new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric' }).format(new Date(d + '-01'));
const ratingTxt = fill(T.rating, { rating: s.rating.toLocaleString(lang), source: s.source, count: s.count });
---
<div class="reviews">
  <div class="rv-summary" data-reveal>
    <span class="rv-stars" aria-hidden="true">{[1, 2, 3, 4, 5].map((i) => <Icon name="star" class={i <= Math.round(s.rating) ? 'on' : ''} />)}</span>
    <a href={s.url} target="_blank" rel="noopener">{ratingTxt} · {s.award}<span class="sr-only"> {dict[lang].common.newTab}</span></a>
  </div>
  <ul class="grid grid-3" role="list">
    {list.map((r, i) => (
      <li class="rv" data-reveal style={`--d:${i * 0.1}s`}>
        <figure>
          <Icon name="quote" class="rv-q" />
          <blockquote lang="it"><p>{r.text}</p></blockquote>
          <figcaption><strong>{r.author}</strong> · {r.source}, {fmtDate(r.date)}{lang !== 'it' && <span class="rv-orig"> · {T.original}</span>}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</div>
<style>
  .rv-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; margin-bottom: 2rem; font-weight: 650; }
  .rv-summary a { text-decoration: none; }
  .rv-summary a:hover { text-decoration: underline; }
  .rv-stars { display: flex; gap: 0.15rem; color: #c9b9a8; }
  .rv-stars :global(.icon) { width: 1.25rem; height: 1.25rem; }
  .rv-stars :global(.on) { color: var(--ember); fill: var(--ember); }
  .rv figure { margin: 0; height: 100%; display: flex; flex-direction: column; padding: clamp(1.5rem, 1.2rem + 1vw, 2.2rem); border-radius: var(--radius); background: rgba(255,255,255,.7); border: 1px solid rgba(42,36,32,.07); box-shadow: var(--shadow-sm); }
  .rv-q { width: 2rem; height: 2rem; color: var(--ember); margin-bottom: 1rem; }
  .rv blockquote { margin: 0 0 1.4rem; flex: 1; font-family: var(--serif); font-size: var(--step-1); line-height: 1.45; font-weight: 500; color: var(--ink); }
  .rv figcaption { font-size: 0.88rem; color: var(--muted); }
  .rv figcaption strong { color: var(--ink); }
</style>
