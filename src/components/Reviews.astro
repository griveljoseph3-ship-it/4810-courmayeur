---
/** Recensioni: una citazione grande, le altre in colonne con filetti. Niente box. */
import reviews from '../data/reviews.json';
import { dict, fill } from '../i18n';
import type { Lang } from '../lib/routes';
interface Props { lang: Lang; service?: 'food' | 'rental'; limit?: number }
const { lang, service, limit = 3 } = Astro.props;
const T = dict[lang].home.reviews;
const list = reviews.reviews.filter((r) => !service || r.service === service).slice(0, limit);
const s = reviews.summary;
const fmtDate = (d: string) => new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric' }).format(new Date(d + '-01'));
const ratingTxt = fill(T.rating, { rating: s.rating.toLocaleString(lang), source: s.source, count: s.count });
const [first, ...rest] = [...list].sort((a, b) => a.text.length - b.text.length);
---
<div class="rv">
  <p class="caps rv-sum" data-reveal><a href={s.url} target="_blank" rel="noopener">★ {ratingTxt} · {s.award}<span class="sr-only"> {dict[lang].common.newTab}</span></a></p>
  <figure class="rv-main">
    <blockquote lang="it"><p data-lines>“{first.text}”</p></blockquote>
    <figcaption class="caps" data-reveal>{first.author} — {first.source}, {fmtDate(first.date)}{lang !== 'it' && <> · {T.original}</>}</figcaption>
  </figure>
  {rest.length > 0 && (
    <ul class="rv-rest" role="list">
      {rest.map((r, i) => (
        <li data-reveal style={`--d:${i * 0.12}s`}>
          <figure>
            <blockquote lang="it"><p>“{r.text}”</p></blockquote>
            <figcaption class="caps">{r.author} — {r.source}, {fmtDate(r.date)}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  )}
</div>
<style>
  .rv-sum { color: var(--fg-soft); margin-bottom: clamp(2rem, 1rem + 3vw, 4rem); }
  .rv-sum a { text-decoration: none; }
  .rv-sum a:hover { text-decoration: underline; }
  .rv-main blockquote { margin: 0; }
  .rv-main p { font-family: var(--display); font-weight: 340; font-size: clamp(1.9rem, 1.2rem + 3.2vw, 4.6rem); line-height: 1.08; letter-spacing: -0.025em; max-width: 22ch; text-wrap: balance; }
  .rv-main figcaption { margin-top: 2rem; color: var(--fg-soft); }
  .rv-rest { display: grid; gap: 2.5rem 4rem; margin-top: var(--space-block); padding-top: 2.5rem; border-top: 1px solid var(--line); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .rv-rest blockquote { margin: 0 0 1.2rem; font-size: var(--fs-lead); line-height: 1.5; }
  .rv-rest figcaption { color: var(--fg-soft); }
</style>
