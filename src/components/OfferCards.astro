---
import Icon from './Icon.astro';
import { dict } from '../i18n';
import { site } from '../lib/data';
import { href, type Lang } from '../lib/routes';
interface Props { lang: Lang; ids?: string[] }
const { lang } = Astro.props;
const T = dict[lang];
const ids = Astro.props.ids ?? site.offers.map((o) => o.id);
const icons: Record<string, string> = { online15: 'tag', hotels: 'chalet', transfer: 'bus', outlet70: 'bag', season: 'calendar', usedSkis: 'ski' };
const linkFor = (l: string) => (l === 'rentalOnline' ? site.booking.rentalOnline : href(l as any, lang));
---
<ul class="offers grid grid-3" role="list">
  {ids.map((id, i) => {
    const o = site.offers.find((x) => x.id === id)!;
    const t = (T.offers.items as any)[id];
    const url = linkFor(o.link);
    const ext = url.startsWith('http');
    const value = (T.offers.valueLabels as any)[o.value] ?? o.value;
    return (
      <li class="offer" data-reveal style={`--d:${(i % 3) * 0.1}s`}>
        <a href={url} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
          <span class="offer-top"><span class="offer-icon"><Icon name={icons[id] ?? 'tag'} /></span><span class="offer-value">{value}</span></span>
          <span class="offer-title">{t.title}</span>
          <span class="offer-text">{t.text}</span>
          <span class="offer-cta">{t.cta} <Icon name={ext ? 'external' : 'arrow'} /></span>
          {ext && <span class="sr-only">{T.common.newTab}</span>}
        </a>
      </li>
    );
  })}
</ul>
<style>
  .offer a {
    position: relative; display: flex; flex-direction: column; height: 100%;
    padding: clamp(1.5rem, 1.1rem + 1.2vw, 2.2rem); border-radius: var(--radius);
    background: linear-gradient(160deg, #fffdf9 0%, #f6efe6 100%);
    border: 1px solid rgba(42, 36, 32, 0.07);
    box-shadow: var(--shadow-sm);
    text-decoration: none; color: var(--ink); overflow: hidden;
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }
  .offer a::before {
    content: ''; position: absolute; inset: auto -30% -60% auto; width: 70%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(203, 96, 21, 0.14), transparent 70%); transition: transform 0.8s var(--ease-out);
  }
  .offer a:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .offer a:hover::before { transform: scale(1.3); }
  .offer-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.6rem; }
  .offer-icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 14px; background: var(--ink); color: #f6c9a6; }
  .offer-icon :global(.icon) { width: 1.4rem; height: 1.4rem; }
  .offer-value { font-family: var(--serif); font-size: 2.6rem; font-weight: 600; line-height: 1; color: var(--ember-ink); letter-spacing: -0.02em; }
  .offer-title { font-family: var(--serif); font-size: var(--step-2); font-weight: 600; line-height: 1.1; margin-bottom: 0.6rem; }
  .offer-text { color: var(--ink-2); flex: 1; margin-bottom: 1.4rem; }
  .offer-cta { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--ember-ink); }
  .offer-cta :global(.icon) { width: 1.05rem; height: 1.05rem; transition: transform 0.4s var(--ease-out); }
  .offer a:hover .offer-cta :global(.icon) { transform: translateX(4px); }
</style>
