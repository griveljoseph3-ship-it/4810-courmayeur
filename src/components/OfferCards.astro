---
/** Offerte come schede sovrapposte: ogni scheda si ferma in alto e la successiva le scivola sopra. */
import Icon from './Icon.astro';
import { dict } from '../i18n';
import { site } from '../lib/data';
import { href, type Lang } from '../lib/routes';
interface Props { lang: Lang; ids?: string[] }
const { lang } = Astro.props;
const T = dict[lang];
const ids = Astro.props.ids ?? site.offers.map((o) => o.id);
const tones = ['ember', 'ink', 'glacier', 'bone', 'pine', 'lilac'];
const linkFor = (l: string) => (l === 'rentalOnline' ? site.booking.rentalOnline : href(l as any, lang));
---
<ol class="stack" role="list">
  {ids.map((id, i) => {
    const o = site.offers.find((x) => x.id === id)!;
    const t = (T.offers.items as any)[id];
    const url = linkFor(o.link);
    const ext = url.startsWith('http');
    const value = (T.offers.valueLabels as any)[o.value] ?? o.value;
    return (
      <li class:list={['sc', `tone-${tones[i % tones.length]}`]} style={`--i:${i}`}>
        <a href={url} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
          <span class="sc-n caps">{String(i + 1).padStart(2, '0')} / {String(ids.length).padStart(2, '0')}</span>
          <span class="sc-value num" aria-hidden="true">{value}</span>
          <span class="sc-body">
            <span class="sc-title">{t.title}</span>
            <span class="sc-text">{t.text}</span>
            <span class="sc-cta">{t.cta} <Icon name={ext ? 'external' : 'arrow'} />{ext && <span class="sr-only"> {T.common.newTab}</span>}</span>
          </span>
        </a>
      </li>
    );
  })}
</ol>
<style>
  .stack { display: grid; gap: 1.25rem; }
  .sc { position: sticky; top: calc(5.5rem + var(--i) * 0.9rem); }
  .sc a {
    display: grid; gap: 1.5rem 3rem; align-items: end; min-height: min(62vh, 30rem);
    padding: clamp(1.6rem, 1rem + 3vw, 4rem); border-radius: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    text-decoration: none; background: var(--c-bg); color: var(--c-fg);
    box-shadow: 0 -18px 40px -28px rgba(20, 17, 15, 0.5);
    transition: transform 0.7s var(--ease-out);
  }
  .sc a:hover { transform: translateY(-6px); }
  @media (min-width: 900px) { .sc a { grid-template-columns: 1.1fr 1fr; grid-template-rows: auto 1fr; } .sc-n { grid-column: 1 / -1; } }
  .tone-ember { --c-bg: #a44c0e; --c-fg: #fff7ef; }
  .tone-ink { --c-bg: #14110f; --c-fg: #f4f0e8; }
  .tone-glacier { --c-bg: #1f6182; --c-fg: #f1f7fa; }
  .tone-bone { --c-bg: #e6dfd2; --c-fg: #14110f; }
  .tone-pine { --c-bg: #2f5246; --c-fg: #eef3ef; }
  .tone-lilac { --c-bg: #6f3f73; --c-fg: #fbf3fa; }
  .sc-n { opacity: 0.85; }
  .sc-value { font-family: var(--display); font-weight: 300; font-size: clamp(4.5rem, 2rem + 13vw, 15rem); line-height: 0.82; letter-spacing: -0.05em; }
  .sc-body { display: grid; gap: 0.8rem; max-width: 30rem; }
  .sc-title { font-family: var(--display); font-size: var(--fs-h3); line-height: 1.08; letter-spacing: -0.015em; }
  .sc-text { opacity: 0.92; }
  .sc-cta { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; margin-top: 0.6rem; padding-bottom: 3px; border-bottom: 1px solid currentColor; width: fit-content; }
  .sc-cta :global(.icon) { width: 1rem; height: 1rem; transition: transform 0.5s var(--ease-out); }
  .sc a:hover .sc-cta :global(.icon) { transform: translateX(4px); }
</style>
