---
import { site, WEEK, fmtSlots, slotsFor, serviceTbc, tbc } from '../lib/data';
import type { Lang } from '../lib/routes';
import { dict } from '../i18n';
interface Props { service: keyof typeof site.services; lang: Lang; season?: 'winter' | 'summer' }
const { service, lang, season } = Astro.props;
const T = dict[lang].common;
const s: any = (site.services as any)[service];
const src: any = s.sameHoursAs ? (site.services as any)[s.sameHoursAs] : s;
const week = season ? src.hours[season] : src.hours.all;
const rows = WEEK.map((d) => ({ d, text: fmtSlots(slotsFor(week, d), lang) }));
// Raggruppa giorni con lo stesso orario: se tutti uguali, una sola riga "Tutti i giorni".
const allSame = rows.every((r) => r.text === rows[0].text);
const render = (txt: string) => txt.replaceAll(tbc(lang), `<span class="tbc">${tbc(lang)}</span>`);
---
<dl class="week">
  {allSame ? (
    <div><dt>{T.everyDay}</dt><dd set:html={render(rows[0].text)} /></div>
  ) : rows.map((r) => (
    <div class:list={[{ closed: r.text === T.closed }]} data-day={r.d}><dt>{(T.days as any)[r.d]}</dt><dd set:html={render(r.text)} /></div>
  ))}
</dl>
{serviceTbc(service) && <p class="week-note"><span class="tbc">{tbc(lang)}</span></p>}
<style>
  .week { margin: 0; display: grid; gap: 0.15rem; font-variant-numeric: tabular-nums; }
  .week div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .week div:last-of-type { border-bottom: 0; }
  .week dt { color: var(--muted); }
  .week dd { margin: 0; font-weight: 620; text-align: right; }
  .week .closed dd { color: var(--muted); font-weight: 500; }
  .week-note { margin: 0.5rem 0 0; }
  :global(.on-dark) .week dt { color: rgba(247,244,239,.7); }
  :global(.on-dark) .week div { border-color: rgba(255,255,255,.14); }
</style>
