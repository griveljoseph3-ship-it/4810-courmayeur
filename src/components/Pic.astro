---
import { Picture } from 'astro:assets';
import { img } from '../lib/images';
import { dict } from '../i18n';
import type { Lang } from '../lib/routes';

interface Props {
  name: string;
  lang: Lang;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  alt?: string;
}
const { name, lang, sizes = '(min-width: 900px) 50vw, 100vw', widths, eager = false, class: cls, alt } = Astro.props;
const src = img(name);
const alts = (dict[lang] as any).alt ?? {};
const altText = alt ?? alts[name] ?? '';
if (!altText && import.meta.env.DEV) console.warn('ALT mancante per', name, lang);
const maxW = src.width;
const w = (widths ?? [480, 768, 1080, 1440, 1920]).filter((x) => x <= maxW);
if (!w.includes(maxW) && maxW < 1920) w.push(maxW);
---
<Picture
  src={src}
  alt={altText}
  widths={w}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  quality={eager ? 50 : 55}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
  class={cls}
/>
