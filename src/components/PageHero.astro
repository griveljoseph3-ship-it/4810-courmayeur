---
/** Hero delle pagine servizio: foto grande a tutto schermo, un solo pulsante principale. */
import Pic from './Pic.astro';
import type { Lang } from '../lib/routes';
interface Props { lang: Lang; image: string; kicker: string; title: string; sub?: string; tint?: 'dawn' | 'day' | 'dusk' | 'night' | 'lilac'; short?: boolean; position?: string }
const { lang, image, kicker, title, sub, tint = 'day', short = false, position = 'center' } = Astro.props;
---
<section class:list={['phero', `tint-${tint}`, { short }]} data-hero>
  <div class="phero-media">
    <Pic name={image} lang={lang} eager sizes="100vw" widths={[640, 960, 1280, 1600, 2000]} class="phero-img" />
  </div>
  <div class="phero-shade" aria-hidden="true"></div>
  <div class="wrap phero-copy on-dark" data-hero-copy>
    <p class="kicker">{kicker}</p>
    <h1 class="phero-title">{title}</h1>
    {sub && <p class="lead">{sub}</p>}
    <div class="actions"><slot /></div>
  </div>
</section>
<style define:vars={{ pos: position }}>
  .phero { position: relative; min-height: min(100svh, 980px); display: grid; align-items: end; color: #fff; overflow: hidden; background: var(--ink); isolation: isolate; }
  .phero.short { min-height: min(78svh, 760px); }
  .phero-media { position: absolute; inset: 0; z-index: -2; }
  .phero-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); transform-origin: center 60%; }
  .phero-shade { position: absolute; inset: 0; z-index: -1; }
  .tint-day .phero-shade { background: linear-gradient(180deg, rgba(27,26,42,.45) 0%, rgba(27,26,42,0) 28%, rgba(27,26,42,.15) 55%, rgba(27,22,18,.78) 100%); }
  .tint-dawn .phero-shade { background: linear-gradient(180deg, rgba(64,34,40,.5) 0%, rgba(203,96,21,.08) 35%, rgba(42,26,20,.25) 60%, rgba(30,20,16,.82) 100%); }
  .tint-dusk .phero-shade { background: linear-gradient(180deg, rgba(27,26,42,.5) 0%, rgba(203,96,21,.1) 40%, rgba(42,24,18,.85) 100%); }
  .tint-night .phero-shade { background: linear-gradient(180deg, rgba(27,26,42,.55) 0%, rgba(27,26,42,.2) 40%, rgba(17,16,28,.9) 100%); }
  .tint-lilac .phero-shade { background: linear-gradient(180deg, rgba(60,36,60,.45) 0%, rgba(122,76,122,.1) 40%, rgba(42,24,38,.85) 100%); }
  .phero-copy { padding-top: 8rem; padding-bottom: clamp(3.5rem, 2rem + 6vw, 7rem); }
  .phero-title { font-size: var(--step-5); max-width: 15ch; text-shadow: 0 2px 30px rgba(0,0,0,.25); animation: rise 1.4s var(--ease-out) both 0.1s; }
  .phero-copy .kicker { color: #f6c9a6; animation: rise 1.2s var(--ease-out) both; }
  .phero-copy .lead { color: rgba(255,255,255,.9); animation: rise 1.4s var(--ease-out) both 0.25s; }
  .phero-copy .actions { animation: rise 1.4s var(--ease-out) both 0.4s; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
</style>
