---
import TitleHero from '../components/TitleHero.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import data from '../data/hotels.json';
import { dict, fill } from '../i18n';
import { type Lang } from '../lib/routes';
import { site, telHref, tbc } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = dict[lang];
const H = T.hotels;
const zones = [...new Set(data.hotels.map((h) => h.zone))];
const host = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<TitleHero kicker={H.hero.kicker} title={H.hero.title} sub={H.hero.sub}>
  <Cta href={site.booking.rentalOnline} lang={lang} size="lg">{T.cta.rentNow}</Cta>
</TitleHero>

<section class="section">
  <div class="wrap">
    <div class="chips" role="group" aria-label={H.filterAll}>
      <button type="button" data-zone-filter="all" aria-pressed="true">{H.filterAll}</button>
      {zones.map((z) => <button type="button" data-zone-filter={z} aria-pressed="false">{(H.zones as any)[z]}</button>)}
    </div>
    {zones.map((z) => {
      const list = data.hotels.filter((h) => h.zone === z);
      return (
        <section class="zone" data-zone={z} aria-labelledby={`z-${z}`}>
          <div class="zone-head"><h2 id={`z-${z}`}>{(H.zones as any)[z]}</h2><span class="muted small">{fill(H.count, { n: list.length })}</span></div>
          <ul class="grid grid-3" role="list">
            {list.map((h: any) => (
              <li class="hotel">
                <h3>{h.name}</h3>
                {h.stars && <p class="stars" aria-label={`${h.stars} ${T.common.stars}`}>{'★'.repeat(h.stars)}</p>}
                <p class="addr">{h.address}</p>
                <ul class="hl" role="list">
                  {h.phone && <li><Icon name="phone" /><a href={telHref(h.phone)}>{h.phone}</a></li>}
                  {h.email && <li><Icon name="mail" /><a href={`mailto:${h.email}`}>{h.email}</a></li>}
                  {h.url
                    ? <li><Icon name="globe" /><a href={h.url} target="_blank" rel="noopener">{host(h.url)}<span class="sr-only"> {T.common.newTab}</span></a></li>
                    : <li><Icon name="globe" /><span class="tbc">{tbc(lang)}</span></li>}
                </ul>
                {h.tbc && h.url && <p class="small"><span class="tbc">{tbc(lang)}</span></p>}
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>
</section>
<style>
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2.5rem; position: sticky; top: 4.75rem; z-index: 5; padding: 0.6rem 0; background: linear-gradient(var(--bg) 75%, transparent); }
  .chips button { min-height: 2.6rem; padding: 0.4rem 1rem; border-radius: 999px; border: 1px solid var(--line); background: transparent; cursor: pointer; font-weight: 650; font-size: 0.9rem; transition: background-color .25s, color .25s; }
  .chips button[aria-pressed='true'] { background: #14110f; color: var(--bg); border-color: #14110f; }
  .zone { margin-bottom: 3.5rem; }
  .zone-head { display: flex; align-items: baseline; gap: 1rem; border-bottom: 1px solid var(--line); margin-bottom: 1.5rem; }
  .zone-head h2 { font-size: var(--fs-h2); margin: 0 0 0.3rem; }
  .hotel { border-top: 1px solid var(--line); padding-top: 1.2rem; }
  .hotel h3 { font-size: 1.15rem; font-family: var(--sans); font-weight: 750; margin-bottom: 0.2rem; line-height: 1.3; }
  .stars { color: var(--ember-ink); letter-spacing: 0.15em; margin: 0 0 0.4rem; font-size: 0.9rem; }
  .addr { color: var(--fg-soft); font-size: 0.92rem; }
  .hl { display: grid; gap: 0.45rem; font-size: 0.92rem; }
  .hl li { display: flex; gap: 0.55rem; align-items: center; min-width: 0; }
  .hl :global(.icon) { width: 1.05rem; height: 1.05rem; flex: none; }
  .hl a { overflow-wrap: anywhere; font-weight: 600; text-decoration: none; }
  .hl a:hover { text-decoration: underline; }
</style>
