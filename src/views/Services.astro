---
import TitleHero from '../components/TitleHero.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { dict } from '../i18n';
import { href, type Lang } from '../lib/routes';
import { site } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = dict[lang];
const S = T.services;
const list: { key: keyof typeof S.items; icon: string; link?: string }[] = [
  { key: 'skiRental', icon: 'ski', link: href('rental', lang) },
  { key: 'skiService', icon: 'wrench' },
  { key: 'bootFitting', icon: 'boot', link: '#boot-fitting' },
  { key: 'storage', icon: 'locker' },
  { key: 'transfer', icon: 'bus', link: href('hotels', lang) },
  { key: 'freeride', icon: 'freeride' },
  { key: 'climbing', icon: 'axe', link: href('shop', lang) },
  { key: 'ebike', icon: 'bike', link: href('rental', lang, 'e-bike') },
  { key: 'outdoor', icon: 'hike', link: href('shop', lang) },
  { key: 'cakes', icon: 'cake', link: href('bakery', lang) },
];
---
<TitleHero kicker={S.hero.kicker} title={S.hero.title} sub={S.hero.sub}>
  <Cta href={site.booking.rentalOnline} lang={lang} size="lg">{T.cta.rentNow}</Cta>
</TitleHero>

<section class="section">
  <div class="wrap">
    <ul class="rows" role="list">
      {list.map((s, i) => {
        const it = S.items[s.key];
        return (
          <li data-reveal>
            <span class="idx num">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="svc-t">{s.link ? <a href={s.link}>{it.title}</a> : it.title}</h2>
            <p>{it.text}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<section class="section band-paper" id="boot-fitting">
  <div class="wrap split">
    <div class="bf-media">
      <figure class="frame ratio-45" data-mask="left"><Pic name="bootfitting-1" lang={lang} /></figure>
    </div>
    <div>
      <p class="kicker" data-reveal>{S.bootFitting.kicker}</p>
      <h2 data-lines>{S.bootFitting.title}</h2>
      <p class="lead" data-reveal>{S.bootFitting.text}</p>
      <ol class="bf-steps" data-reveal>{S.bootFitting.steps.map((s, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{s}</li>)}</ol>
      <div class="actions" data-reveal><Cta href={`mailto:${site.services.shop.email}`} lang={lang} icon="mail">{S.bootFitting.cta}</Cta></div>
    </div>
  </div>
</section>
<style>
  .svc-t { font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.6rem); margin: 0; transition: transform .6s var(--ease-out); }
  .rows li:hover .svc-t { transform: translateX(.6rem); }
  .svc-t a { text-decoration: none; }
  .svc-t a:hover { color: var(--ember-ink); }
  .bf-steps { list-style: none; padding: 0; margin: 2rem 0 0; border-top: 1px solid var(--line); }
  .bf-steps li { display: flex; gap: 1.5rem; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--line); font-size: var(--fs-lead); }
  .bf-steps span { font-family: var(--display); font-style: italic; color: var(--ember-ink); }
</style>
