---
import Pic from '../components/Pic.astro';
import Cta from '../components/Cta.astro';
import HScroll from '../components/HScroll.astro';
import { dict } from '../i18n';
import { type Lang } from '../lib/routes';
import { site, chaletBooking, tbc } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = dict[lang];
const C = T.chalet;
const book = chaletBooking(lang);
const email = site.services.chalet.email;
---
<!-- APERTURA silenziosa: foto piena, testo piccolo al centro, tanto respiro -->
<section class="c-hero" data-hero>
  <div class="c-media" data-hero-media><Pic name="chalet-baita" lang={lang} eager sizes="100vw" widths={[640, 960, 1280, 1800]} /></div>
  <div class="c-shade" aria-hidden="true"></div>
  <div class="c-copy" data-hero-copy>
    <p class="caps c-k">{C.hero.kicker}</p>
    <h1>{C.hero.title}</h1>
    <span class="c-rule" aria-hidden="true"></span>
    <p class="c-sub">{C.hero.sub}</p>
    <div class="actions"><Cta href={book} lang={lang} variant="white">{T.cta.bookChalet}</Cta></div>
  </div>
</section>

<!-- TESTO STRETTO, MOLTO VUOTO -->
<section class="c-intro">
  <div class="c-narrow">
    <p class="caps muted" data-reveal>{C.intro.title}</p>
    <p class="c-statement" data-lines>{C.intro.text}</p>
  </div>
</section>

<!-- GALLERIA ORIZZONTALE -->
<section class="c-gallery" data-hscroll-pin>
  <HScroll lang={lang} height="clamp(20rem, 68vh, 46rem)" shapes={['3/2', '3/4', '4/3', '3/4', '3/2', '1/1', '3/4']}
    images={['chalet-soggiorno', 'chalet-camera', 'chalet-terrazza-vista', 'chalet-balcone', 'chalet-pranzo', 'chalet-giardino', 'chalet-matrimoniale', 'chalet-sala', 'chalet-baita-prato']} />
</section>

<!-- UNA SOLA FOTO, GRANDE -->
<section class="c-view">
  <figure class="frame" data-mask="center" data-parallax="5"><Pic name="chalet-vista-ghiacciaio" lang={lang} sizes="100vw" widths={[640, 960, 1280, 1800]} /></figure>
</section>

<!-- IN BREVE: scheda a filetti + prenotazione in 3 passaggi -->
<section class="section band-light c-facts">
  <div class="c-facts-grid wrap">
    <div>
      <h2 data-lines>{C.steps.title}</h2>
      <ol class="c-steps" role="list">{C.steps.items.map((s, i) => <li data-reveal style={`--d:${i * 0.1}s`}><span class="num">{i + 1}</span>{s}</li>)}</ol>
      <div class="actions" data-reveal><Cta href={book} lang={lang} size="lg">{T.cta.bookChalet}</Cta></div>
    </div>
    <dl class="c-dl">
      <div><dt class="caps">{C.facts.address}</dt><dd><span class="tbc">{tbc(lang)}</span></dd></div>
      <div><dt class="caps">{C.facts.services}</dt><dd><span class="tbc">{tbc(lang)}</span></dd></div>
      <div><dt class="caps">{C.facts.prices}</dt><dd><span class="tbc">{tbc(lang)}</span><br /><span class="small muted">{C.facts.pricesText}</span></dd></div>
      <div><dt class="caps">{C.facts.contact}</dt><dd><a href={`mailto:${email}`}>{email}</a><br /><span class="small muted">{T.common.phone}: </span><span class="tbc">{tbc(lang)}</span></dd></div>
    </dl>
  </div>
</section>

<style>
  .c-hero { position: relative; min-height: 100svh; display: grid; place-items: center; text-align: center; overflow: hidden; isolation: isolate; color: #f3efe6; }
  .c-media { position: absolute; inset: 0; z-index: -2; }
  .c-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 60%; animation: c-zoom 6s var(--ease-out) both; }
  @keyframes c-zoom { from { transform: scale(1.12); } }
  .c-shade { position: absolute; inset: 0; z-index: -1; background: rgba(16, 22, 19, 0.56); }
  .c-copy { display: grid; justify-items: center; gap: 1.6rem; padding: 7rem var(--gutter) calc(4rem + var(--dock-h)); max-width: 46rem; animation: fade 2.4s var(--ease) both 0.2s; }
  .c-k { letter-spacing: 0.4em; }
  .c-hero h1 { font-size: clamp(2.4rem, 1.6rem + 3.6vw, 5rem); line-height: 1.05; margin: 0; }
  .c-rule { width: 1px; height: 4rem; background: currentColor; opacity: 0.6; }
  .c-sub { max-width: 30rem; margin: 0; color: #e4dfd4; }
  .c-copy .actions { margin-top: 0.6rem; }

  .c-intro { padding-block: clamp(8rem, 5rem + 14vw, 18rem); }
  .c-narrow { width: min(100% - 2 * var(--gutter), 52rem); margin-inline: auto; display: grid; gap: 2.5rem; }
  .c-statement { font-family: var(--display); font-weight: 280; font-size: clamp(1.6rem, 1.1rem + 2.2vw, 3.1rem); line-height: 1.22; letter-spacing: -0.015em; margin: 0; }

  .c-gallery { padding-block: var(--space-block); }
  .c-view { padding: var(--space-section) var(--gutter); }
  .c-view figure { aspect-ratio: 16 / 9; max-width: 72rem; margin-inline: auto; }
  @media (max-width: 700px) { .c-view figure { aspect-ratio: 4 / 5; } }

  .c-facts-grid { display: grid; gap: 4rem clamp(2rem, 7vw, 9rem); }
  @media (min-width: 900px) { .c-facts-grid { grid-template-columns: 1fr 1fr; align-items: start; } }
  .c-facts h2 { font-size: clamp(2.2rem, 1.6rem + 2.6vw, 4rem); }
  .c-steps { margin-top: 2rem; border-top: 1px solid var(--line); }
  .c-steps li { display: flex; gap: 1.5rem; align-items: baseline; padding: 1.1rem 0; border-bottom: 1px solid var(--line); font-size: var(--fs-lead); }
  .c-steps .num { font-family: var(--display); font-style: italic; color: var(--accent-ink); }
  .c-dl { margin: 0; border-top: 1px solid var(--line); }
  .c-dl div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .c-dl dt { color: var(--fg-soft); padding-top: 0.25rem; }
  .c-dl dd { margin: 0; }
  .c-dl a { font-weight: 550; }
</style>
