---
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Cta from '../components/Cta.astro';
import OfferCards from '../components/OfferCards.astro';
import Reviews from '../components/Reviews.astro';
import HScroll from '../components/HScroll.astro';
import TodayHours from '../components/TodayHours.astro';
import { dict } from '../i18n';
import { href, type Lang } from '../lib/routes';
import { site, telHref, directions, chaletBooking } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = dict[lang];
const H = T.home;
const M = Object.fromEntries(H.moments.map((m) => [m.id, m]));
const C = H.chapters;
const ids = ['alba', 'mattina', 'pranzo', 'pomeriggio', 'sera'];
const meta = (i: number, time: string) => `${String(i + 1).padStart(2, '0')} — ${C[i]} · ${time}`;
const brands = site.rentalBrands.ski.concat(site.rentalBrands.snowboard, site.rentalBrands.boots);
const N = H.numbers;
const numText = [H.why.nameText, H.why.items[0].text, H.why.items[1].text];
---
<!-- APERTURA: foto a tutto schermo, marchio enorme, una frase, un pulsante -->
<section class="hero" data-hero>
  <div class="hero-media" data-hero-media>
    <Pic name="hero-dente-del-gigante" lang={lang} eager sizes="100vw" widths={[640, 960, 1280, 1600, 2000]} />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-copy" data-hero-copy>
    <div class="hero-row wrap">
      <p class="hero-line">{H.hero.title}, <em>{H.hero.titleEm}.</em></p>
      <Cta href={site.booking.rentalOnline} lang={lang} size="lg" variant="ember">{T.cta.rentNow}</Cta>
    </div>
    <h1 class="hero-brand"><span class="hero-mark"><Logo /><span class="sr-only">4810 </span></span><span class="hero-word">Courmayeur</span></h1>
  </div>
</section>

<nav class="chap-nav" aria-label={H.hero.scroll} data-chap-nav>
  {ids.map((id, i) => <a href={`#${id}`} data-chap-link><span class="num">{String(i + 1).padStart(2, '0')}</span><span class="chap-l">{C[i]}</span></a>)}
</nav>

<div class="day" data-day>
  <!-- 01 ALBA · Pasticceria — morbida: arco, crema e lilla -->
  <section class="ch ch-alba" id="alba" data-theme="bakery" data-chapter data-bg="#fbf3ea" aria-labelledby="h-alba">
    <p class="ghost num" aria-hidden="true" data-drift="6">{M.bakery.time}</p>
    <div class="wrap alba-grid">
      <header class="alba-head">
        <p class="kicker" data-reveal>{meta(0, M.bakery.time)}</p>
        <h2 id="h-alba" data-lines>{M.bakery.title}</h2>
      </header>
      <p class="lead alba-text" data-reveal>{M.bakery.text}</p>
      <figure class="frame alba-arch" data-mask="center"><Pic name="bakery-croissant" lang={lang} sizes="(min-width: 900px) 34vw, 78vw" widths={[480, 720, 960, 1280]} /></figure>
      <div class="alba-cta" data-reveal style="--d:.15s"><Cta href={href('bakery', lang)} lang={lang} size="lg">{T.cta.discoverBakery}</Cta></div>
    </div>
  </section>

  <!-- 02 MATTINA · Noleggio — sportivo: foto piena, taglio diagonale, nastro di marchi -->
  <section class="ch ch-mattina" id="mattina" data-theme="rental" data-chapter data-bg="#0e1a22" aria-labelledby="h-mattina">
    <div class="mat-media" data-parallax="6"><Pic name="rental-sci-stockli" lang={lang} sizes="100vw" widths={[640, 960, 1280, 1600, 2000]} /></div>
    <div class="mat-shade" aria-hidden="true"></div>
    <div class="wrap mat-copy">
      <p class="kicker" data-reveal>{meta(1, M.rental.time)}</p>
      <h2 id="h-mattina" data-lines>{M.rental.title}</h2>
      <div class="mat-foot">
        <p class="lead" data-reveal>{M.rental.text}</p>
        <div data-reveal style="--d:.15s"><Cta href={site.booking.rentalOnline} lang={lang} size="lg" variant="white">{T.cta.rentNow}</Cta></div>
      </div>
    </div>
    <div class="marquee mat-marquee" aria-hidden="true"><div class="marquee-track">{[0, 1].map(() => brands.map((b) => <span>{b} /</span>))}</div></div>
  </section>

  <!-- 03 PRANZO · Ristorante — caldo: metà fissa, l'immagine cambia tra pranzo e aperitivo -->
  <section class="ch ch-pranzo" id="pranzo" data-theme="food" data-chapter data-bg="#1f140e" data-swap-scope aria-labelledby="h-pranzo">
    <div class="pr-sticky" aria-hidden="true">
      <figure class="frame pr-img on" data-swap="a"><Pic name="food-risotto" lang={lang} sizes="50vw" widths={[640, 960, 1280]} alt="" /></figure>
      <figure class="frame pr-img" data-swap="b"><Pic name="food-cocktail" lang={lang} sizes="50vw" widths={[640, 960, 1280]} alt="" /></figure>
    </div>
    <div class="pr-panels">
      <article class="pr-panel" data-swap-trigger="a">
        <figure class="frame pr-inline" data-mask="left"><Pic name="food-risotto" lang={lang} sizes="100vw" widths={[480, 720, 960]} /></figure>
        <p class="kicker" data-reveal>{meta(2, M.restaurant.time)}</p>
        <h2 id="h-pranzo" data-lines>{M.restaurant.title}</h2>
        <p class="lead" data-reveal>{M.restaurant.text}</p>
        <div class="actions" data-reveal><Cta href={site.booking.lunch} lang={lang} size="lg">{T.cta.bookTable}</Cta></div>
      </article>
      <article class="pr-panel" data-swap-trigger="b">
        <figure class="frame pr-inline" data-mask="left"><Pic name="food-cocktail" lang={lang} sizes="100vw" widths={[480, 720, 960]} /></figure>
        <p class="kicker" data-reveal>{M.aperitivo.label} · {M.aperitivo.time}</p>
        <h2 data-lines>{M.aperitivo.title}</h2>
        <p class="lead" data-reveal>{M.aperitivo.text}</p>
        <div class="actions" data-reveal><Cta href={site.booking.aperitivo} lang={lang} size="lg">{T.cta.bookAperitivo}</Cta></div>
      </article>
    </div>
  </section>

  <!-- 04 POMERIGGIO · Negozio — editoriale: griglia asimmetrica da rivista -->
  <section class="ch ch-pome" id="pomeriggio" data-theme="shop" data-chapter data-bg="#fbf9f4" aria-labelledby="h-pome">
    <div class="wrap pome-grid">
      <p class="caps pome-meta" data-reveal><span>{meta(3, M.shop.time)}</span><span>Via Roma 106</span></p>
      <h2 id="h-pome" data-lines>{M.shop.title}</h2>
      <figure class="frame pome-a" data-mask="right"><Pic name="shop-grivel" lang={lang} sizes="(min-width: 900px) 58vw, 100vw" widths={[640, 960, 1280, 1800]} /></figure>
      <figure class="frame pome-b" data-mask="up" data-speed="0.6"><Pic name="family-negozio" lang={lang} sizes="(min-width: 900px) 26vw, 60vw" widths={[400, 640, 900]} /></figure>
      <div class="pome-text">
        <p class="lead" data-reveal>{M.shop.text}</p>
        <div class="actions" data-reveal><Cta href={href('shop', lang)} lang={lang} size="lg">{T.cta.discoverShop}</Cta></div>
      </div>
    </div>
  </section>

  <!-- 05 SERA · Chalet — lusso silenzioso: galleria che scorre in orizzontale -->
  <section class="ch ch-sera" id="sera" data-theme="chalet" data-chapter data-bg="#141b18" data-hscroll-pin aria-labelledby="h-sera">
    <HScroll lang={lang} images={['chalet-soggiorno', 'chalet-terrazza-vista', 'chalet-camera', 'chalet-balcone', 'chalet-baita']}>
      <div class="sera-lead" slot="lead">
        <p class="kicker">{meta(4, M.chalet.time)}</p>
        <h2 id="h-sera">{M.chalet.title}</h2>
        <p class="lead">{M.chalet.text}</p>
        <div class="actions"><Cta href={chaletBooking(lang)} lang={lang} size="lg" variant="white">{T.cta.bookChalet}</Cta></div>
      </div>
    </HScroll>
  </section>
</div>

<!-- NUMERI GIGANTI: perché 4810 -->
<section class="section nums band-bone" data-bg="#f4f0e8">
  <div class="wrap">
    <p class="kicker" data-reveal>{H.why.kicker}</p>
    <h2 class="nums-title" data-lines>{H.why.title}</h2>
    <ul class="nums-list" role="list">
      {N.map((n, i) => (
        <li>
          <p class="nums-v num" data-reveal><span>{n.value}</span><small>{n.unit}</small></p>
          <div class="nums-t" data-reveal style="--d:.1s"><p class="caps">{n.label}</p><p>{numText[i]}</p></div>
        </li>
      ))}
    </ul>
    <p class="nums-more" data-reveal><Cta href={href('family', lang)} lang={lang} variant="link">{T.nav.family}</Cta></p>
  </div>
</section>

<!-- OFFERTE: schede sovrapposte -->
<section class="section band-paper offers-home">
  <div class="wrap">
    <div class="oh-head">
      <div><p class="kicker" data-reveal>{H.offers.kicker}</p><h2 data-lines>{H.offers.title}</h2></div>
      <Cta href={href('offers', lang)} lang={lang} variant="link">{T.cta.seeOffers}</Cta>
    </div>
    <OfferCards lang={lang} ids={['online15', 'transfer', 'outlet70']} />
  </div>
</section>

<!-- RECENSIONI: una citazione enorme -->
<section class="section band-bone">
  <div class="wrap"><p class="kicker" data-reveal>{H.reviews.kicker}</p><Reviews lang={lang} limit={3} /></div>
</section>

<!-- DOVE SIAMO -->
<section class="section band-paper where">
  <div class="wrap">
    <p class="kicker" data-reveal>{H.where.kicker}</p>
    <h2 data-lines>{H.where.title}</h2>
    <div class="where-grid">
      {[
        { key: 'dolonne', img: 'food-esterno-neve', title: H.where.dolonne, svc: 'rental', label: T.nav.rental, mask: 'up' },
        { key: 'centro', img: 'shop-vetrine', title: H.where.centro, svc: 'shop', label: T.nav.shop, mask: 'down' },
      ].map((w) => {
        const p: any = (site.places as any)[w.key];
        return (
          <article class="where-item">
            <figure class="frame ratio-43 zoom" data-mask={w.mask}><Pic name={w.img} lang={lang} sizes="(min-width: 900px) 45vw, 92vw" widths={[480, 720, 960, 1280]} /></figure>
            <p class="caps where-k">{w.title}</p>
            <h3>{p.street}</h3>
            <p class="where-today">{T.common.today} · {w.label}: <TodayHours service={w.svc as any} lang={lang} /></p>
            <p class="where-links">
              <a class="link" href={directions(w.key as any)} target="_blank" rel="noopener"><Icon name="pin" />{T.common.directions}<span class="sr-only"> {T.common.newTab}</span></a>
              <a class="link" href={telHref(p.phone)}><Icon name="phone" />{p.phone}</a>
            </p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; height: 100svh; min-height: 34rem; display: grid; align-items: end; overflow: hidden; background: #14110f; color: #fff; isolation: isolate; }
  .hero-media { position: absolute; inset: 0; z-index: -2; animation: hero-open 1.8s var(--ease-out) both; }
  @keyframes hero-open { from { clip-path: inset(26% 30% 26% 30%); } to { clip-path: inset(0 0 0 0); } }
  .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; animation: hero-zoom 2.6s var(--ease-out) both; }
  @keyframes hero-zoom { from { transform: scale(1.25); } }
  .hero-shade { position: absolute; inset: 0; z-index: -1; background: radial-gradient(110% 60% at 80% 0%, rgba(255, 160, 110, 0.32), transparent 60%), linear-gradient(180deg, rgba(20, 17, 15, 0.5) 0%, rgba(20, 17, 15, 0) 26%, rgba(20, 17, 15, 0.1) 50%, rgba(20, 17, 15, 0.82) 100%); }
  .hero-copy { padding-bottom: calc(var(--dock-h) + 0.5rem); }
  .hero-row { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem 3rem; margin-bottom: clamp(0.5rem, 2vw, 1.5rem); animation: rise 1.4s var(--ease-out) both 0.9s; }
  .hero-line { font-family: var(--display); font-weight: 350; font-size: clamp(1.5rem, 1.1rem + 1.9vw, 2.9rem); line-height: 1.1; letter-spacing: -0.02em; max-width: 17ch; margin: 0; text-wrap: balance; }
  .hero-line em { color: #f6c9a6; }
  .hero-brand { display: flex; align-items: flex-end; gap: 2.2vw; margin: 0; padding-inline: var(--gutter); font-size: 16.6vw; line-height: 0.74; font-weight: 300; letter-spacing: -0.055em; white-space: nowrap; overflow: hidden; padding-bottom: 0.12em; }
  .hero-mark { flex: none; display: block; animation: rise 1.4s var(--ease-out) both 0.5s; }
  .hero-mark :global(svg) { width: 0.62em; height: auto; margin-bottom: 0.02em; }
  .hero-word { display: block; animation: word-up 1.6s var(--ease-out) both 0.55s; }
  @keyframes word-up { from { transform: translateY(100%); } }
  @media (min-width: 900px) { .hero-copy { padding-bottom: 1.5rem; } .hero-brand { font-size: 15.4vw; } }

  /* Indice capitoli */
  .chap-nav { position: fixed; left: calc(var(--gutter) / 2 - 0.6rem); top: 50%; transform: translateY(-50%); z-index: 20; display: none; flex-direction: column; gap: 0.9rem; mix-blend-mode: difference; color: #fff; opacity: 0; pointer-events: none; transition: opacity 0.6s var(--ease); }
  .chap-nav.show { opacity: 1; pointer-events: auto; }
  .chap-nav a { display: flex; align-items: center; gap: 0.6rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-decoration: none; text-transform: uppercase; opacity: 0.45; transition: opacity 0.4s; }
  .chap-nav a.on, .chap-nav a:hover { opacity: 1; }
  .chap-l { max-width: 0; overflow: hidden; white-space: nowrap; transition: max-width 0.6s var(--ease-out); }
  .chap-nav a.on .chap-l, .chap-nav a:hover .chap-l { max-width: 9rem; }
  @media (min-width: 1200px) { .chap-nav { display: flex; } }

  /* ---------- CAPITOLI ---------- */
  .ch { position: relative; background: var(--bg); color: var(--fg); }
  :global(html.flow) .ch { background: transparent; }

  /* 01 Alba */
  .ch-alba { padding-block: var(--space-section); overflow: clip; }
  .ghost { position: absolute; top: 4%; left: 0; right: 0; text-align: center; margin: 0; font-family: var(--display); font-style: italic; font-weight: 300; font-size: var(--fs-mega); line-height: 1; letter-spacing: -0.05em; color: var(--accent); opacity: 0.28; pointer-events: none; white-space: nowrap; }
  .alba-grid { position: relative; display: grid; gap: 2rem; justify-items: center; text-align: center; }
  .alba-head h2 { max-width: 11ch; margin-inline: auto; font-size: var(--fs-display); }
  .alba-arch { width: min(78vw, 30rem); aspect-ratio: 3 / 4; border-radius: 999px 999px var(--radius) var(--radius); }
  .alba-text { max-width: 26rem; }
  @media (min-width: 900px) {
    .alba-grid { grid-template-columns: 1fr minmax(0, 30rem) 1fr; align-items: end; gap: 3rem; }
    .alba-head { grid-column: 1 / -1; }
    .alba-text { text-align: left; justify-self: end; padding-bottom: 3rem; }
    .alba-cta { justify-self: start; padding-bottom: 3rem; }
    .alba-arch { grid-column: 2; width: 100%; }
    .alba-text { grid-column: 1; grid-row: 2; }
    .alba-cta { grid-column: 3; grid-row: 2; }
    .alba-arch { grid-row: 2; }
  }

  /* 02 Mattina */
  .ch-mattina { min-height: 100svh; display: grid; align-items: end; overflow: hidden; isolation: isolate; clip-path: polygon(0 5vw, 100% 0, 100% 100%, 0 100%); margin-top: -5vw; padding-top: 5vw; color: #fff; --fg: #fff; --fg-soft: rgba(255,255,255,.85); }
  .mat-media { position: absolute; inset: 0; z-index: -2; }
  .mat-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .mat-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(200deg, rgba(14, 26, 34, 0.25) 0%, rgba(14, 26, 34, 0.55) 45%, rgba(14, 26, 34, 0.94) 100%); }
  .mat-copy { padding-block: 9rem 3rem; }
  .ch-mattina h2 { font-size: clamp(3.2rem, 1rem + 11.5vw, 12.5rem); max-width: 9ch; margin-bottom: 0.25em; }
  .mat-foot { display: grid; gap: 1.5rem 4rem; align-items: end; }
  @media (min-width: 900px) { .mat-foot { grid-template-columns: minmax(0, 30rem) auto; justify-content: space-between; } }
  .mat-marquee { border-top: 1px solid rgba(255, 255, 255, 0.25); padding: 0.9rem 0; font-stretch: 75%; font-weight: 700; font-style: italic; text-transform: uppercase; font-size: clamp(1rem, 0.8rem + 1vw, 1.6rem); letter-spacing: 0.02em; color: rgba(255,255,255,.85); --dur: 30s; }

  /* 03 Pranzo */
  .ch-pranzo { display: grid; }
  .pr-sticky { display: none; }
  .pr-panel { padding: var(--space-block) var(--gutter); }
  .pr-inline { aspect-ratio: 4 / 5; margin-bottom: 2.5rem; }
  .pr-panel h2 { max-width: 12ch; }
  @media (min-width: 900px) {
    .ch-pranzo { grid-template-columns: 1fr 1fr; }
    .pr-sticky { display: block; position: sticky; top: 0; height: 100vh; overflow: hidden; }
    .pr-img { position: absolute; inset: 0; border-radius: 0; opacity: 0; transform: scale(1.06); transition: opacity 1.2s var(--ease), transform 2s var(--ease-out); }
    .pr-img.on { opacity: 1; transform: none; }
    .pr-inline { display: none; }
    .pr-panel { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 6rem clamp(2.5rem, 6vw, 7rem); }
  }

  /* 04 Pomeriggio */
  .ch-pome { padding-block: var(--space-section); }
  .pome-grid { display: grid; gap: 2rem; }
  .pome-meta { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); color: var(--fg-soft); }
  .ch-pome h2 { font-size: var(--fs-display); max-width: 9ch; margin: 0; }
  .pome-a { aspect-ratio: 16 / 10; }
  .pome-b { aspect-ratio: 3 / 4; width: 62%; justify-self: end; }
  @media (min-width: 900px) {
    .pome-grid { grid-template-columns: repeat(12, 1fr); gap: 2rem 2.5rem; align-items: start; }
    .pome-meta { grid-column: 1 / -1; }
    .ch-pome h2 { grid-column: 1 / 9; grid-row: 2; position: relative; z-index: 2; margin-bottom: -0.32em; padding-top: 2rem; }
    .pome-a { grid-column: 1 / 8; grid-row: 3; }
    .pome-b { grid-column: 9 / 13; grid-row: 2 / 4; width: 100%; margin-top: 7rem; }
    .pome-text { grid-column: 9 / 13; grid-row: 4; }
    .pome-a { margin-left: calc(var(--gutter) * -1); }
  }

  /* 05 Sera */
  .ch-sera { padding-block: var(--space-block); min-height: 100svh; display: grid; align-items: center; }
  .sera-lead { width: min(84vw, 30rem); padding-right: clamp(1rem, 4vw, 6rem); }
  .sera-lead h2 { font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4.8rem); line-height: 1.02; }
  .sera-lead .lead { color: var(--fg-soft); }

  /* ---------- NUMERI ---------- */
  :global(html.flow) .nums { background: transparent; }
  .nums-title { max-width: 14ch; margin-bottom: var(--space-block); }
  .nums-list { border-top: 1px solid var(--line); }
  .nums-list li { display: grid; gap: 0.5rem 3rem; align-items: end; padding: clamp(1rem, 0.5rem + 2vw, 2.5rem) 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .nums-list li { grid-template-columns: 1.5fr 1fr; } }
  .nums-v { margin: 0; font-family: var(--display); font-weight: 300; font-size: var(--fs-mega); line-height: 0.82; letter-spacing: -0.06em; display: flex; align-items: baseline; gap: 0.12em; }
  .nums-v small { font-size: 0.2em; letter-spacing: 0; font-style: italic; color: var(--ember-ink); }
  .nums-t { max-width: 26rem; padding-bottom: 0.6rem; }
  .nums-t .caps { color: var(--ember-ink); margin-bottom: 0.6rem; }
  .nums-t p:last-child { color: var(--fg-soft); }
  .nums-more { margin-top: 2.5rem; }

  .oh-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem 3rem; margin-bottom: var(--space-block); }
  .oh-head h2 { margin: 0; max-width: 12ch; }

  /* ---------- DOVE ---------- */
  .where h2 { margin-bottom: var(--space-block); }
  .where-grid { display: grid; gap: 4rem clamp(2rem, 5vw, 6rem); }
  @media (min-width: 900px) { .where-grid { grid-template-columns: 1fr 1fr; } .where-item:nth-child(2) { margin-top: 7rem; } }
  .where-k { color: var(--fg-soft); margin: 1.6rem 0 0.6rem; }
  .where-item h3 { font-size: var(--fs-h2); margin-bottom: 0.3em; }
  .where-today { font-weight: 550; }
  .where-links { display: flex; flex-wrap: wrap; gap: 0.8rem 2rem; margin-top: 1.2rem; }
  .where-links :global(.icon) { width: 1.05rem; height: 1.05rem; }
</style>
